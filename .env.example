# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INSTAGRAM_SESSION_ID: Optional server-side Instagram sessionid cookie for
# fetching public Instagram Stories when Instagram restricts anonymous requests.
INSTAGRAM_SESSION_ID=""

# TIKTOK_COOKIE: Optional Netscape cookies.txt content from a logged-in
# tiktok.com browser session. Required for TikTok videos flagged
# "not comfortable for some audiences" that demand login.
TIKTOK_COOKIE=""

# INSTAGRAM_COOKIE: Optional Netscape cookies.txt content from a logged-in
# instagram.com browser session. Passed to yt-dlp for Reels/TV/Posts when
# Instagram restricts anonymous access.
INSTAGRAM_COOKIE=""
